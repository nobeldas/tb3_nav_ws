<?xml version="1.0"?>
<sdf version="1.8">
  <world name="arena">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><direction>-0.5 -0.5 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision"><geometry><box><size>8 8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 8 0.1</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="north_wall"><static>true</static><pose>0 3.9 0.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>8 0.2 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.2 0.5</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -3.9 0.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>8 0.2 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.2 0.5</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>3.9 0 0.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.2 8 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 8 0.5</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-3.9 0 0.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.2 8 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 8 0.5</size></box></geometry></visual></link></model>
    <model name="center_block"><static>true</static><pose>-0.5 0 0.4 0 0 0</pose><link name="block"><collision name="c"><geometry><box><size>0.7 2 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 2 0.8</size></box></geometry><material><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link></model>
    <model name="east_block"><static>true</static><pose>1.2 1 0.4 0 0 0</pose><link name="block"><collision name="c"><geometry><box><size>1 0.7 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1 0.7 0.8</size></box></geometry><material><diffuse>0.1 0.3 0.8 1</diffuse></material></visual></link></model>
    <model name="tb3_burger">
      <pose>-3 -3 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.09 0 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.008</izz></inertia></inertial>
        <collision name="body_collision"><geometry><cylinder><radius>0.105</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="body_visual"><geometry><cylinder><radius>0.105</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <sensor name="scan" type="gpu_lidar">
          <pose>0 0 0.07 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate>
          <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range></ray>
        </sensor>
      </link>
      <link name="left_wheel"><pose>0 0.08 0.033 -1.570796 0 0</pose><inertial><mass>0.03</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></visual></link>
      <link name="right_wheel"><pose>0 -0.08 0.033 -1.570796 0 0</pose><inertial><mass>0.03</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.16</wheel_separation><wheel_radius>0.033</wheel_radius>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.22</max_linear_velocity><max_angular_velocity>2.84</max_angular_velocity>
      </plugin>
    </model>
  </world>
</sdf>
